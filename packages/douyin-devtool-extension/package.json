{
  "name": "gameforge-douyin-devtool-extension",
  "displayName": "GameForge Douyin Bridge",
  "description": "Local-only bridge between GameForge and the Douyin Mini Game DevTool.",
  "version": "0.1.0",
  "publisher": "gameforge",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.59.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gameforgeDouyin.connect",
    "onCommand:gameforgeDouyin.disconnect",
    "onCommand:gameforgeDouyin.showStatus"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/bridge-connection-manager.js",
    "dist/bridge-client.js",
    "dist/cdp-client.js",
    "dist/protocol.js",
    "dist/runtime-probe.js",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gameforgeDouyin.connect",
        "title": "GameForge: Connect Local Bridge"
      },
      {
        "command": "gameforgeDouyin.disconnect",
        "title": "GameForge: Disconnect Local Bridge"
      },
      {
        "command": "gameforgeDouyin.showStatus",
        "title": "GameForge: Show Bridge Status"
      }
    ],
    "configuration": {
      "title": "GameForge Douyin Bridge",
      "properties": {
        "gameforgeDouyinBridge.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Connect to the local GameForge controller after the DevTool starts."
        },
        "gameforgeDouyinBridge.port": {
          "type": "number",
          "default": 47653,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Loopback TCP port of the local GameForge controller."
        },
        "gameforgeDouyinBridge.cdpPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Loopback CDP port exposed by the running Douyin DevTool; 0 auto-discovers DevToolsActivePort."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --legal-comments=eof --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "test": "vitest run src",
    "smoke": "bun src/smoke.ts",
    "runtime-smoke": "bun src/runtime-smoke.ts"
  },
  "dependencies": {
    "chrome-remote-interface": "0.34.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "22.20.1",
    "@types/vscode": "1.59.0",
    "devtools-protocol": "0.0.1663043",
    "esbuild": "0.25.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
