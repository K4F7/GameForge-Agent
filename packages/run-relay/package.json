{
  "name": "@gameforge/run-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gameforge-run-relay": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run src"
  },
  "dependencies": {
    "@gameforge/contracts": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
