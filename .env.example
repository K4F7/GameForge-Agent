# Workbench browser-visible configuration only. Never place provider credentials in VITE_* variables.
VITE_AGENT_BASE_URL=http://127.0.0.1:8787/
VITE_GAME_PREVIEW_URL=http://localhost:5173/
# Comma-separated exact HTTPS origins for remote generated-game previews.
VITE_GAME_PREVIEW_ORIGINS=https://preview.example.com

# MCP server-only examples; keep real values in the launching shell or secret manager.
GAMEFORGE_PROJECT_OUTPUT_ROOT=
GAMEFORGE_RUN_RELAY_URL=http://127.0.0.1:8787/
